# Copy to .env on the VPS and fill in. NEVER commit the real .env.
SPRINTFLOW_JWT_SECRET=changeme-generate-with-openssl-rand-hex-32
BACKEND_TAG=sprintflow-latest
FRONTEND_TAG=sprintflow-latest
# Local evaluation: one-click demo login with sample data. Set 0 (or unset) for any shared/production deploy.
SPRINTFLOW_ENABLE_DEMO=1
